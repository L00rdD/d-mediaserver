# Copy this file to .env, then edit it:   cp .env.example .env
# Every line is optional: remove the "#" in front of a setting to use it.
# Without a .env the stack uses the Raspberry Pi defaults.

# Folder that holds movies/, shows/, complete/ and incomplete/
#DATA_ROOT=/volume1/media

# User and group that own that folder (run `id` on the machine)
#PUID=1026
#PGID=100

#TZ=Europe/Paris

# Port of the home page, if 80 is already taken (a NAS often uses it)
#HOME_PORT=8088

# No login for Radarr, Sonarr and Prowlarr on the home network
# (see Passwords in the README)
#SKIP_LOCAL_LOGIN=1

# --- Options -----------------------------------------------------------
# An option is one more file added to COMPOSE_FILE, separated by ":".
# Both at once:
# COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml:docker-compose.vpn.yml

# Updating an install made with the first version of this project? Use this
# line: the apps also get their old folder names (/movies, /shows,
# /downloads), so the existing config/ works without touching the apps.
#COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml

# Send Transmission through a VPN (see VPN in the README). VPN_USER and
# VPN_PASSWORD are the "service credentials" of your VPN account (manual
# setup), not the e-mail and password you log in with.
#COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml
#VPN_PROVIDER=nordvpn
#VPN_USER=
#VPN_PASSWORD=
#VPN_COUNTRY=Switzerland
# udp is faster; use tcp if your network blocks the VPN
#VPN_PROTOCOL=udp
