# Copy this file to .env, then edit it:   cp .env.example .env
# Every line is optional: remove the "#" in front of a setting to use it.
# Without a .env the stack uses the Raspberry Pi defaults.

# Folder that holds movies/, shows/, complete/ and incomplete/
#DATA_ROOT=/volume1/media

# User and group that own that folder (run `id` on the machine)
#PUID=1026
#PGID=100

#TZ=Europe/Paris

# Port of the home page, if 80 is already taken (a NAS often uses it)
#HOME_PORT=8088

# No login for Radarr, Sonarr and Prowlarr on the home network
# (see Passwords in the README)
#SKIP_LOCAL_LOGIN=1

# --- Options -----------------------------------------------------------
# An option is one more file added to COMPOSE_FILE, separated by ":".
# Both at once:
# COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml:docker-compose.vpn.yml

# Updating an install made with the first version of this project? Use this
# line: the apps also get their old folder names (/movies, /shows,
# /downloads), so the existing config/ works without touching the apps.
#COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml

# Send Transmission through a VPN (see VPN in the README). VPN_USER and
# VPN_PASSWORD are the "service credentials" of your VPN account (manual
# setup), not the e-mail and password you log in with.
#COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml
#VPN_PROVIDER=nordvpn
#VPN_USER=
#VPN_PASSWORD=
#VPN_COUNTRY=Switzerland
# udp is faster; use tcp if your network blocks the VPN
#VPN_PROTOCOL=udp

# Watch KPIECE for the new One Piece scan (see One Piece in the README):
# a card on the home page and, optionally, the link posted to Discord.
#COMPOSE_FILE=docker-compose.yml:docker-compose.kpiece.yml
#KPIECE_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Ohara, the manga library on port 8585 (see Anime and Manga in the README).
#COMPOSE_FILE=docker-compose.yml:docker-compose.ohara.yml
#OHARA_INDEXERS=YggReborn,Nyaa.si,Knaben
# its own Discord channel, told when tomes come in and when a followed series gets
# new ones, and its address for the links of those messages
#OHARA_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
#OHARA_URL=http://raspberrypi.local:8585

# Follow the Anycubic resin printer (see Resin Printer in the README): a card on
# the home page while it is on. The token comes from the Anycubic web app.
#COMPOSE_FILE=docker-compose.yml:docker-compose.printer.yml
#ANYCUBIC_TOKEN=
#PRINTER_HOST=M7.lan

# Claude Code sessions of a Mac running Cerebro (see Living-room Screen in the
# README): its phone page's address and the key of its link (~/.cerebro/mobile-key).
#CEREBRO_URL=http://10.147.17.5:4243
#CEREBRO_KEY=

# The house's place, for the weather on the living-room screen (Open-Meteo, no
# account): latitude and longitude in decimal degrees. Without them, no weather.
#WEATHER_LAT=
#WEATHER_LON=

# Watchdog (see Keep the Pi Up in the README): Discord webhook for its
# alerts (defaults to AUTOHEAL_WEBHOOK_URL), and a healthchecks.io ping URL
# that warns you when the Pi itself is off or offline.
#WATCHDOG_WEBHOOK_URL=https://discord.com/api/webhooks/...
#WATCHDOG_PING_URL=https://hc-ping.com/...

# Fake releases (see Keep the Pi Up in the README): Discord webhook for what it
# removed (defaults to WATCHDOG_WEBHOOK_URL). Install with: sudo ./fakes/install.sh
#FAKES_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Wifi fallback hotspot (see Keep the Pi Up in the README): the Pi opens its
# own wifi when the home network is gone. Install with: sudo ./hotspot/install.sh
#HOTSPOT_PASSWORD=at-least-8-characters
#HOTSPOT_SSID=dpi-hotspot
# fixed address for the hotspot (default: the last address the Pi had at home)
#HOTSPOT_ADDRESS=192.168.1.229/24
