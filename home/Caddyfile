# Serves the home page over plain HTTP, whatever name or IP is used to reach it.
# "templates" lets the pages link to the apps on the name or IP used to reach
# them and lets index.html pick the look from the "style" cookie.
:80 {
	root * /srv
	templates
	header Cache-Control no-cache

	# /style/<name> remembers the chosen look for a year, then goes back home
	@style path_regexp style ^/style/(reactor|cyberpunk)$
	handle @style {
		header Set-Cookie "style={re.style.1}; Path=/; Max-Age=31536000; SameSite=Lax"
		redir * / 303
	}

	# /search?q=<text>&in=<app> opens that app with the search already typed.
	# The text is taken as typed in the URL (still encoded) and handed over.
	@search {
		path /search
		vars_regexp q {http.request.uri.query} (^|&)q=([^&]*)
	}
	handle @search {
		@radarr query in=radarr
		redir @radarr http://{host}:7878/add/new?term={re.q.2}
		@sonarr query in=sonarr
		redir @sonarr http://{host}:8989/add/new?term={re.q.2}
		redir * http://{host}:8096/web/#/search?query={re.q.2}
	}

	# The theme kit is loaded by projects on other ports of this host (see
	# site/theme/README.md); fonts only load cross-origin with this header
	@theme path /theme/*
	header @theme Access-Control-Allow-Origin *

	# /disk.json is the space used on the data disk, written by the storage service
	handle /disk.json {
		root * /status
		file_server
	}

	handle {
		file_server
	}
}
